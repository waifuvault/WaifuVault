{
    "name": "waifu_vault",
    "version": "1.0.0",
    "description": "Temp file hosting for nerds",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint --max-warnings=0 --disable-nested-config .",
        "lint:fix": "oxlint --disable-nested-config --fix .",
        "tsc": "tsc --project tsconfig.json",
        "build": "npm run barrels && node ./buildScripts/cleanDist.mjs && tsc -p tsconfig.build.json && node ./buildScripts/copyAssets.mjs",
        "barrels": "barrels",
        "start_js": "node dist/index.js",
        "start_js:ci": "node dist/index.js -ghAction",
        "runmigration:ci": "node dist/db/runMigration.js -ghAction",
        "start": "npm run build && npm run start_js",
        "start:prod": "cross-env NODE_ENV=production nodemon dist/index.js",
        "update_deps": "npx npm-check-updates",
        "typeorm": "typeorm",
        "blankmigration": "typeorm migration:create",
        "generatemigration": "npm run build && typeorm migration:generate -d ./dist/db/DataSource.js",
        "runmigration": "npm run build && node dist/db/runMigration.js",
        "revertmigration": "npm run build && typeorm migration:revert -d ./dist/db/DataSource.js",
        "format": "oxfmt --check ./src",
        "format:fix": "oxfmt ./src",
        "prepare": "husky",
        "docker:compose:build": "docker compose up -d --build"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1138.0",
        "@aws-sdk/lib-storage": "^3.1138.0",
        "@smithy/node-http-handler": "^4.12.1",
        "@socket.io/redis-adapter": "^8.3.0",
        "@tsed/ajv": "^8.38.8",
        "@tsed/core": "^8.38.8",
        "@tsed/di": "^8.38.8",
        "@tsed/engines": "^8.38.8",
        "@tsed/exceptions": "^8.38.8",
        "@tsed/hooks": "^8.38.8",
        "@tsed/ioredis": "^8.38.8",
        "@tsed/json-mapper": "^8.38.8",
        "@tsed/logger": "8.0.5",
        "@tsed/logger-file": "8.0.5",
        "@tsed/logger-std": "^8.0.5",
        "@tsed/passport": "^8.38.8",
        "@tsed/platform-cache": "^8.38.8",
        "@tsed/platform-exceptions": "^8.38.8",
        "@tsed/platform-express": "^8.38.8",
        "@tsed/platform-http": "^8.38.8",
        "@tsed/platform-log-middleware": "^8.38.8",
        "@tsed/platform-log-request": "^8.38.8",
        "@tsed/platform-middlewares": "^8.38.8",
        "@tsed/platform-multer": "^8.38.8",
        "@tsed/platform-params": "^8.38.8",
        "@tsed/platform-response-filter": "^8.38.8",
        "@tsed/platform-views": "^8.38.8",
        "@tsed/scalar": "^8.38.8",
        "@tsed/schema": "^8.38.8",
        "@tsed/socketio": "^8.38.8",
        "@tsed/swagger": "^8.38.8",
        "ajv": "^8.20.0",
        "archiver": "^8.0.0",
        "argon2": "^0.45.1",
        "better-sqlite3": "^12.11.1",
        "body-parser": "^2.3.0",
        "builder-pattern": "^2.2.0",
        "compression": "^1.8.2",
        "connect-redis": "^10.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cronstrue": "^3.27.0",
        "cross-env": "^10.1.0",
        "dotenv": "^18.0.3",
        "dotenv-expand": "^1000.0.0",
        "dotenv-flow": "^4.1.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "express-session": "^1.19.0",
        "ffmpeg-ffprobe-static": "^6.1.2-rc.1",
        "file-type": "^22.1.1",
        "fluent-ffmpeg": "^2.1.3",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^5.11.1",
        "is-localhost-ip": "^3.0.1",
        "method-override": "^3.0.0",
        "mime": "^4.1.0",
        "node-schedule": "^2.1.1",
        "passport": "^0.7.0",
        "passport-custom": "^1.2.1",
        "passport-http": "^0.3.0",
        "passport-local": "^1.0.0",
        "pg": "^8.23.0",
        "punycode": "^2.3.1",
        "redis": "^6.2.1",
        "socket.io": "^4.8.3",
        "toad-scheduler": "^4.2.0",
        "typeorm": "^1.1.1",
        "typeorm-rate-limit-store": "^1.1.1",
        "uuid": "^14.0.2",
        "xss": "^1.0.15",
        "xxhash-wasm": "^1.1.0"
    },
    "devDependencies": {
        "@tsed/barrels": "^7.7.0",
        "@tsed/cli-plugin-passport": "7.7.0",
        "@types/archiver": "^8.0.0",
        "@types/cache-manager-ioredis": "^2.0.8",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/jsdom": "^30.0.0",
        "@types/method-override": "^3.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.6.2",
        "@types/node-schedule": "^2.1.8",
        "@types/passport": "^1.0.17",
        "@types/passport-http": "^0.3.11",
        "@types/passport-local": "^1.0.38",
        "@types/punycode": "^2.1.4",
        "aws-sdk-client-mock": "^4.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "nodemon": "^3.1.14",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "tsc-files": "^1.1.4",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    },
    "main": "index.js",
    "keywords": [],
    "author": "Victoria",
    "license": "MIT",
    "tsed": {
        "packageManager": "npm",
        "convention": "default",
        "architecture": "default"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "tsc-files --noEmit --pretty",
            "oxlint --max-warnings=0 --disable-nested-config --fix",
            "oxfmt"
        ]
    },
    "allowScripts": {
        "@scarf/scarf@1.4.0": true,
        "ffmpeg-ffprobe-static@6.1.2-rc.1": true,
        "argon2@0.45.1": true,
        "better-sqlite3@12.11.1": true
    }
}
