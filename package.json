{
    "name": "waifu_vault",
    "version": "1.0.0",
    "description": "Temp file hosting for nerds",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint --no-fix --max-warnings 0 .",
        "lint:fix": "eslint --fix .",
        "tsc": "tsc --project tsconfig.json",
        "build": "npm run barrels && node ./buildScripts/cleanDist.mjs && swc src -d dist --config-file .swcrc --copy-files --strip-leading-paths --ignore \"**/__TEST__/**\"",
        "barrels": "barrels",
        "start_js": "node dist/index.js",
        "start_js:ci": "node dist/index.js -ghAction",
        "runmigration:ci": "node dist/db/runMigration.js -ghAction",
        "start": "node --import @swc-node/register/esm-register src/index.ts",
        "start:prod": "cross-env NODE_ENV=production nodemon dist/index.js",
        "update_deps": "npx npm-check-updates",
        "typeorm": "typeorm-ts-node-esm",
        "blankmigration": "typeorm-ts-node-esm migration:create",
        "generatemigration": "typeorm-ts-node-esm migration:generate -d ./src/db/DataSource.ts",
        "runmigration": "typeorm-ts-node-esm migration:run -d ./src/db/DataSource.ts",
        "revertmigration": "typeorm-ts-node-esm migration:revert -d ./src/db/DataSource.ts",
        "prettier": "prettier ./src --check",
        "prettier:fix": "prettier ./src --write",
        "prepare": "husky",
        "docker:compose:build": "docker compose up -d --build"
    },
    "dependencies": {
        "@socket.io/redis-adapter": "^8.3.0",
        "@tsed/ajv": "^8.37.1",
        "@tsed/core": "^8.37.1",
        "@tsed/di": "^8.37.1",
        "@tsed/engines": "^8.37.1",
        "@tsed/exceptions": "^8.37.1",
        "@tsed/hooks": "^8.37.1",
        "@tsed/ioredis": "^8.37.1",
        "@tsed/json-mapper": "^8.37.1",
        "@tsed/logger": "8.0.5",
        "@tsed/logger-file": "8.0.5",
        "@tsed/logger-std": "^8.0.5",
        "@tsed/passport": "^8.37.1",
        "@tsed/platform-cache": "^8.37.1",
        "@tsed/platform-exceptions": "^8.37.1",
        "@tsed/platform-express": "^8.37.1",
        "@tsed/platform-http": "^8.37.1",
        "@tsed/platform-log-middleware": "^8.37.1",
        "@tsed/platform-log-request": "^8.37.1",
        "@tsed/platform-middlewares": "^8.37.1",
        "@tsed/platform-multer": "^8.37.1",
        "@tsed/platform-params": "^8.37.1",
        "@tsed/platform-response-filter": "^8.37.1",
        "@tsed/platform-views": "^8.37.1",
        "@tsed/scalar": "^8.37.1",
        "@tsed/schema": "^8.37.1",
        "@tsed/socketio": "^8.37.1",
        "@tsed/swagger": "^8.37.1",
        "ajv": "^8.20.0",
        "archiver": "^8.0.0",
        "argon2": "^0.45.1",
        "better-sqlite3": "^12.11.1",
        "body-parser": "^2.3.0",
        "builder-pattern": "^2.2.0",
        "compression": "^1.8.1",
        "connect-redis": "^9.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cronstrue": "^3.24.0",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "dotenv-expand": "^1000.0.0",
        "dotenv-flow": "^4.1.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "express-session": "^1.19.0",
        "ffmpeg-ffprobe-static": "^6.1.2-rc.1",
        "file-type": "^22.0.1",
        "fluent-ffmpeg": "^2.1.3",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^5.11.1",
        "is-localhost-ip": "^3.0.1",
        "method-override": "^3.0.0",
        "mime": "^4.1.0",
        "node-schedule": "^2.1.1",
        "passport": "^0.7.0",
        "passport-custom": "^1.2.1",
        "passport-http": "^0.3.0",
        "passport-local": "^1.0.0",
        "pg": "^8.22.0",
        "punycode": "^2.3.1",
        "redis": "^6.1.0",
        "socket.io": "^4.8.3",
        "toad-scheduler": "^4.1.0",
        "typeorm": "^1.1.0",
        "typeorm-rate-limit-store": "^1.1.1",
        "uuid": "^14.0.1",
        "xss": "^1.0.15",
        "xxhash-wasm": "^1.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@swc-node/register": "^1.12.1",
        "@swc/cli": "0.8.1",
        "@swc/core": "^1.15.47",
        "@swc/helpers": "^0.5.23",
        "@tsed/barrels": "^7.5.2",
        "@tsed/cli-plugin-passport": "7.5.2",
        "@types/archiver": "^8.0.0",
        "@types/cache-manager-ioredis": "^2.0.8",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/jsdom": "^28.0.3",
        "@types/method-override": "^3.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.1",
        "@types/node-schedule": "^2.1.8",
        "@types/passport": "^1.0.17",
        "@types/passport-http": "^0.3.11",
        "@types/passport-local": "^1.0.38",
        "@types/punycode": "^2.1.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-files": "^1.1.4",
        "tsconfig-paths": "^4.2.0",
        "tslib": "^2.8.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.65.0",
        "unplugin-swc": "^1.5.9",
        "vitest": "^4.1.10"
    },
    "main": "index.js",
    "keywords": [],
    "author": "Victoria",
    "license": "MIT",
    "tsed": {
        "packageManager": "npm",
        "convention": "default",
        "architecture": "default"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "tsc-files --noEmit --pretty",
            "eslint --cache --fix",
            "prettier --write"
        ]
    },
    "allowScripts": {
        "@scarf/scarf@1.4.0": true,
        "ffmpeg-ffprobe-static@6.1.2-rc.1": true,
        "@swc/core@1.15.47": true,
        "argon2@0.45.1": true,
        "better-sqlite3@12.11.1": true
    }
}
